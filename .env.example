APP_NAME=Barta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Locales enabled for the multilingual front-end & admin (comma separated)
BARTA_LOCALES=bn,en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Database — MySQL 8 / MariaDB 10.6+ recommended for a news portal.
# For a quick local spin-up you may switch DB_CONNECTION=sqlite.
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barta
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@barta.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Barta CMS
# ------------------------------------------------------------------
BARTA_ACTIVE_THEME=barta
BARTA_PERMALINK=date        # options: default | date | day | month | postname | category

# ------------------------------------------------------------------
# AI assistance (OpenAI-compatible: OpenAI, OpenRouter, Groq, local Ollama…)
# ------------------------------------------------------------------
AI_ENABLED=false
AI_DRIVER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60

# ------------------------------------------------------------------
# Payments (sandbox by default)
# ------------------------------------------------------------------
PAYMENT_CURRENCY=BDT
PAYMENT_DEFAULT_GATEWAY=sslcommerz

SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true
